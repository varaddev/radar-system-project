#include <Servo.h>

Servo radarServo;

// Pin definitions
const int trigPin = 9;
const int echoPin = 10;
const int servoPin = 6;

// Variables
long duration;
int distance;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  radarServo.attach(servoPin);
  Serial.begin(9600);
}

void loop() {

  // Sweep from 0° to 180° (FAST)
  for (int angle = 0; angle <= 180; angle += 2) {
    radarServo.write(angle);
    delay(7);   // Faster servo movement

    distance = getDistance();

    Serial.print(angle);
    Serial.print(",");
    Serial.println(distance);
  }

  // Sweep from 180° to 0° (FAST)
  for (int angle = 180; angle >= 0; angle -= 2) {
    radarServo.write(angle);
    delay(7);   // Faster servo movement

    distance = getDistance();

    Serial.print(angle);
    Serial.print(",");
    Serial.println(distance);
  }
}

// Ultrasonic distance function
int getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000); // timeout for stability
  int dist = duration * 0.034 / 2;

  // Limit max distance for clean radar
  if (dist > 400) dist = 400;
  if (dist <= 0) dist = 400;

  return dist;
}

